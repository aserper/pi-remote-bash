{
  "name": "pi-remote-bash",
  "version": "0.1.1",
  "type": "module",
  "description": "Run complex Bash commands over SSH in Pi without nested escaping or replacing local tools.",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.5.0",
    "typebox": "^1.3.28",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "ssh",
    "remote",
    "bash",
    "extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aserper/pi-remote-bash.git"
  },
  "homepage": "https://github.com/aserper/pi-remote-bash#readme",
  "bugs": {
    "url": "https://github.com/aserper/pi-remote-bash/issues"
  },
  "author": "Amit Serper",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
